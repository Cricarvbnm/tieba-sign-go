pkgname=tieba-sign
pkgver=2.0.0
pkgrel=1

arch=(any)

_repo_dir="tieba-sign-go-$pkgver"

makedepends=(go)
build() {
  cd "$_repo_dir/src" || exit 1
  go build
}

package() {
  install -Dm 0755 -t "$pkgdir/usr/bin" "$srcdir/$_repo_dir/src/tieba-sign"
  install -Dm 0644 -t "$pkgdir/usr/lib/systemd/user" "$srcdir/$_repo_dir"/packaging/common/systemd/tieba-sign.{service,timer}
}

source=(https://github.com/Cricarvbnm/tieba-sign-go/archive/refs/tags/v2.0.0.zip)
sha256sums=('7c778238ecd4030ed971c489b5309910066d6b87f6c4f323d324e8ad1b337595')

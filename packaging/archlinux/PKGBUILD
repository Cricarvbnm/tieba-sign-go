pkgname=tieba-sign
pkgver=2.2.0
pkgrel=1

arch=(any)

makedepends=(go git)

prepare() {
    cd "$startdir/../.." || exit 1
    mkdir -p "$srcdir"
    git archive HEAD | tar xC "$srcdir"
}

build() {
    cd src || exit 1
    go build
}

package() {
    install -Dm 0755 -t "$pkgdir/usr/bin" src/tieba-sign
    install -Dm 0644 -t "$pkgdir/usr/lib/systemd/user" packaging/common/systemd/*
}

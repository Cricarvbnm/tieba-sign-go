pkgname=tieba-sign
pkgver=2.1.0
pkgrel=1

arch=(any)

_repo_dir="tieba-sign-go-$pkgver"

makedepends=(go)
build() {
    cd "$_repo_dir/src" || exit 1
    go build
}

package() {
    install -Dm 0755 -t "$pkgdir/usr/bin" "$srcdir/$_repo_dir/src/tieba-sign"
    install -Dm 0644 -t "$pkgdir/usr/lib/systemd/user" "$srcdir/$_repo_dir"/packaging/common/systemd/tieba-sign.{service,timer}
}

source=(https://github.com/Cricarvbnm/tieba-sign-go/archive/refs/tags/v$pkgver.zip)
sha256sums=('f00468d6a2f753a81cfe16192c7c1d9e857641a70c8bd6e1690427557d6410aa')
